@page "/cart"
@using TGBooksFrontend.Models
@using TGBooksFrontend.Services
@inject CartService CartService
@inject NavigationManager Navigation

<PageTitle>Your Shopping Cart</PageTitle>

<div class="cart-page-wrapper">
    <div class="cart-workspace-container">

        <header class="cart-header">
            <h2>Shopping Cart</h2>
            <span class="cart-count-badge">@((cartItems?.Sum(i => i.Quantity) ?? 0)) Items</span>
        </header>

        @if (!string.IsNullOrEmpty(statusMessage) && isErrorState)
        {
            <div class="cart-status-alert error-state">
                <span>@statusMessage</span>
            </div>
        }

        @if (isLoading)
        {
            <div class="cart-loading-state">
                <div class="spinner-loader"></div>
                <p>Retrieving your selected reading materials. Please wait...</p>
            </div>
        }
        else if (cartItems == null || !cartItems.Any())
        {
            <div class="cart-empty-state">
                <svg width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                </svg>
                <h3>Your cart is empty</h3>
                <p>Explore our library collection to add books to your personal shelf.</p>
                <button class="continue-shopping-btn" @onclick="BrowseCatalogue">
                    Browse Catalogue
                </button>
            </div>
        }
        else
        {
            <div class="cart-content-split">
                <div class="cart-items-list">
                    @foreach (var item in cartItems)
                    {
                        var singleItemPrice = GetEffectivePrice(item);
                        var totalRowPrice = singleItemPrice * item.Quantity;

                        <div class="cart-item-card" @key="item.Id">
                            <div class="item-data-body">
                                <div class="item-image-wrapper">
                                    <img src="@(string.IsNullOrEmpty(item.ImageURL) ? "images/placeholder-book.png" : item.ImageURL)" alt="@item.Title" />
                                </div>

                                <div class="item-details">
                                    <h4 class="item-title" title="@item.Title">@item.Title</h4>
                                    <div class="item-meta-container">
                                        <span class="item-meta-tag">@GetLanguageDisplay(item.Language)</span>
                                        <span class="item-price-each">₾@singleItemPrice.ToString("0.00") each</span>
                                    </div>
                                </div>
                            </div>

                            <div class="item-interactive-group">
                                <div class="item-quantity-controls">
                                    <button class="qty-btn"
                                            @onclick="() => UpdateItemQuantity(item, item.Quantity - 1)"
                                            disabled="@(item.Quantity <= 1 || isProcessing)"
                                            type="button">
                                        −
                                    </button>
                                    <span class="qty-display">@item.Quantity</span>
                                    <button class="qty-btn"
                                            @onclick="() => UpdateItemQuantity(item, item.Quantity + 1)"
                                            disabled="@isProcessing"
                                            type="button">
                                        +
                                    </button>
                                </div>

                                <div class="item-total-price-block">
                                    <span>₾@totalRowPrice.ToString("0.00")</span>
                                </div>
                            </div>

                            <div class="item-actions">
                                <button class="remove-item-btn"
                                        @onclick="() => RemoveItemFromCart(item.Id)"
                                        disabled="@isProcessing"
                                        title="Remove Item"
                                        type="button">
                                    <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                        <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1v1z" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <aside class="cart-summary-sidebar">
                    <div class="summary-card">
                        <h3>Order Summary</h3>

                        <div class="summary-row">
                            <span>Unique Titles</span>
                            <span>@cartItems.Count</span>
                        </div>

                        <div class="summary-row">
                            <span>Total Volume Items</span>
                            <span>@cartItems.Sum(i => i.Quantity)</span>
                        </div>

                        <hr class="summary-divider" />

                        <div class="summary-row total-cost-row">
                            <span>Total Cost</span>
                            <span>₾@CalculateCartTotal().ToString("0.00")</span>
                        </div>

                        <div class="shipping-notice-box">
                            <strong>Standard Distribution Delivery</strong>
                            <p>Shipping logistics parameters handled relative to Georgian regional branches.</p>
                        </div>

                        <button class="checkout-submit-btn"
                                @onclick="ProceedToCheckout"
                                disabled="@(isProcessing || !cartItems.Any())"
                                type="button">
                            Proceed to Checkout
                        </button>
                    </div>
                </aside>
            </div>
        }
    </div>
</div>

@code {
    private List<GetCartItem>? cartItems;
    private bool isLoading = true;
    private bool isProcessing = false;
    private string statusMessage = "";
    private bool isErrorState = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadCartData();
    }

    private async Task LoadCartData()
    {
        try
        {
            isLoading = true;
            statusMessage = "";
            isErrorState = false;

            // GetCartAsync returns a Value Tuple: (List<GetCartItem> Items, string? ErrorMessage)
            var result = await CartService.GetCartAsync();

            // 1. If an explicit server error message is populated, display it as an actual error
            if (!string.IsNullOrEmpty(result.ErrorMessage))
            {
                statusMessage = result.ErrorMessage;
                isErrorState = true;
                cartItems = new List<GetCartItem>();
                return;
            }

            // 2. If Items is null (uninitialized or new user), gracefully fall back to an empty shelf
            // without throwing a 'NullReferenceException' or triggering an error banner
            if (result.Items == null)
            {
                cartItems = new List<GetCartItem>();
                return;
            }

            // 3. Otherwise, map the items cleanly to the UI state
            cartItems = result.Items;
        }
        catch (Exception)
        {
            // Actual server/network exceptions throw a visible UI failure state
            statusMessage = "An unexpected error occurred while retrieving your cart.";
            isErrorState = true;
            cartItems = new List<GetCartItem>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private decimal GetEffectivePrice(GetCartItem item)
    {
        if (item.OnSale && item.OffPercentage > 0)
        {
            decimal discountMultiplier = 100 - item.OffPercentage;
            return (item.OriginalPrice * discountMultiplier) / 100;
        }
        return item.OriginalPrice;
    }

    private decimal CalculateCartTotal()
    {
        if (cartItems == null) return 0;
        return cartItems.Sum(item => GetEffectivePrice(item) * item.Quantity);
    }

    private async Task UpdateItemQuantity(GetCartItem item, int newQuantity)
    {
        if (newQuantity < 1 || isProcessing)
            return;

        try
        {
            isProcessing = true;
            statusMessage = "";
            isErrorState = false;

            var result = await CartService.UpdateItemQuantityAsync(item.Id, newQuantity);

            if (result.Success)
            {
                item.Quantity = result.UpdatedItem?.Quantity ?? newQuantity;
            }
            else
            {
                statusMessage = !string.IsNullOrEmpty(result.Message) ? result.Message : "Requested quantity exceeds available stock limits.";
                isErrorState = true;
            }
        }
        catch
        {
            statusMessage = "Failed to update quantity due to network connection issues.";
            isErrorState = true;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RemoveItemFromCart(int itemId)
    {
        if (isProcessing)
            return;

        try
        {
            isProcessing = true;
            statusMessage = "";
            isErrorState = false;

            var result = await CartService.RemoveItemFromCartAsync(itemId);
            if (result.Success)
            {
                cartItems?.RemoveAll(i => i.Id == itemId);
            }
            else
            {
                statusMessage = result.Message;
                isErrorState = true;
            }
        }
        catch
        {
            statusMessage = "Failed to remove item. Please try again.";
            isErrorState = true;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void ProceedToCheckout() => CartService.ProceedToCheckout();
    private void BrowseCatalogue() => Navigation.NavigateTo("/");

    private string GetLanguageDisplay(int languageValue)
    {
        return languageValue switch
        {
            0 => "English",
            1 => "Georgian",
            2 => "Russian",
            3 => "German",
            4 => "French",
            5 => "Spanish",
            6 => "Polish",
            _ => "Unknown"
        };
    }
}
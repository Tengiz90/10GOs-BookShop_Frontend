@page "/user-profile/details"
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using TGBooksFrontend.Models
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>Manage Profile Settings</PageTitle>

<div class="profile-edit-layout">

    @if (nameModel != null)
    {
        <div class="full-stretch-view">

            <header class="workspace-management-header">
                <button type="button" class="back-nav-btn" @onclick="GoBack">
                    <span>← Back</span>
                </button>

                <h2>Manage Profile Settings</h2>
            </header>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="status-toast-notification @(isErrorStatus ? "error-toast" : "")">
                    @(isErrorStatus ? "❌" : "✨") @statusMessage
                </div>
            }

            <div class="details-form-flex-grid">

                <!-- PERSONAL -->
                <div class="form-card-column">
                    <h3>Personal Identification</h3>

                    <div class="input-row-split">

                        <div class="input-field-group">
                            <label>First Name *</label>
                            <input type="text"
                                   class="@GetNameRequiredInputClass(nameModel.FirstName)"
                                   @bind="nameModel.FirstName" />
                        </div>

                        <div class="input-field-group">
                            <label>Last Name *</label>
                            <input type="text"
                                   class="@GetNameRequiredInputClass(nameModel.LastName)"
                                   @bind="nameModel.LastName" />
                        </div>

                    </div>

                    <div class="input-field-group">
                        <label>Email</label>
                        <input type="email" value="@sessionEmail" readonly />
                    </div>

                    <button class="save-changes-btn"
                            disabled="@isSavingName"
                            @onclick="UpdatePersonalNames">
                        Save Identity Info
                    </button>
                </div>

                <!-- BILLING -->
                <div class="form-card-column">
                    <h3>Billing Address</h3>

                    <div class="input-field-group">
                        <label>Address 1 *</label>
                        <input @bind="billingModel.Address1" />
                    </div>

                    <div class="input-field-group">
                        <label>Address 2</label>
                        <input @bind="billingModel.Address2" />
                    </div>

                    <div class="input-row-split">

                        <div class="input-field-group">
                            <label>City *</label>
                            <input @bind="billingModel.City" />
                        </div>

                        <div class="input-field-group">
                            <label>Postal Code *</label>
                            <input @bind="billingModel.PostalCode" />
                        </div>

                    </div>

                    <div class="input-field-group">
                        <label>Country</label>
                        <input value="Georgia" readonly />
                    </div>

                    <button class="save-changes-btn"
                            disabled="@isSavingBilling"
                            @onclick="UpdateBillingAddress">
                        Save Billing Address
                    </button>
                </div>

            </div>
        </div>
    }
    else
    {
        <p>Loading session...</p>
    }

</div>

@code {
    private string? sessionEmail;

    private EditUserName nameModel = new();
    private UpdateBillingAddress billingModel = new();

    private bool isSavingName;
    private bool isSavingBilling;

    private string statusMessage = "";
    private bool isErrorStatus;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity == null || !user.Identity.IsAuthenticated)
        {
            Navigation.NavigateTo("login");
            return;
        }

        sessionEmail = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        var splitName = user.Identity.Name?.Split(' ');
        nameModel.FirstName = splitName?.FirstOrDefault() ?? "";
        nameModel.LastName = splitName?.Length > 1 ? splitName[1] : "";

        await LoadBillingInfo();
    }

    private async Task LoadBillingInfo()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ApiResponse<GetUserBillingInfoResult>>("users/billing-info");

            if (response?.WasSuccessful == true && response.Data != null)
            {
                nameModel.FirstName = response.Data.FirstName ?? "";
                nameModel.LastName = response.Data.LastName ?? "";

                billingModel.Address1 = response.Data.Address1 ?? "";
                billingModel.Address2 = response.Data.Address2 ?? "";
                billingModel.City = response.Data.City ?? "";
                billingModel.PostalCode = response.Data.PostalCode ?? "";
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task UpdatePersonalNames()
    {
        if (isSavingName) return;

        isSavingName = true;
        statusMessage = "";

        try
        {
            var request = new EditUserName
            {
                FirstName = nameModel.FirstName,
                LastName = nameModel.LastName
            };

            var response = await Http.PutAsJsonAsync("users/edit-name", request);

            if (response.IsSuccessStatusCode)
            {
                statusMessage = "Profile updated";
                isErrorStatus = false;
            }
            else
            {
                statusMessage = "Update failed";
                isErrorStatus = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isErrorStatus = true;
        }
        finally
        {
            isSavingName = false;
        }
    }

    private async Task UpdateBillingAddress()
    {
        if (isSavingBilling) return;

        isSavingBilling = true;

        try
        {
            var request = new UpdateBillingAddress
            {
                Address1 = billingModel.Address1,
                Address2 = billingModel.Address2,
                City = billingModel.City,
                PostalCode = billingModel.PostalCode
            };

            var response = await Http.PutAsJsonAsync("users/edit-billing-address", request);

            if (response.IsSuccessStatusCode)
            {
                statusMessage = "Billing updated";
                isErrorStatus = false;
            }
            else
            {
                statusMessage = "Billing update failed";
                isErrorStatus = true;
            }
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            isErrorStatus = true;
        }
        finally
        {
            isSavingBilling = false;
        }
    }

    private string GetNameRequiredInputClass(string? value)
        => string.IsNullOrWhiteSpace(value) ? "input-error" : "";

    private void GoBack()
        => Navigation.NavigateTo("user-profile");
}
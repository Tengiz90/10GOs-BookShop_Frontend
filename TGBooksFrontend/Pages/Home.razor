@page "/"
@using TGBooksFrontend.Models
@inject HttpClient Http

<PageTitle>Home</PageTitle>

<div class="search-bar-container">
    <input type="text"
           class="search-input"
           placeholder="Search by book title..."
           @bind="searchQuery"
           @bind:event="oninput" />
</div>

@if (books == null)
{
    <div class="loading-container">
        <p>Loading books...</p>
    </div>
}
else if (!FilteredBooks.Any())
{
    <div class="loading-container">
        <p>No books found matching "@searchQuery".</p>
    </div>
}
else
{
    <div class="book-grid">
        @foreach (var book in FilteredBooks)
        {
            <div class="book-card">
                @* The image-container acts as the 'anchor' for the sale badge *@
                <div class="image-container">
                    <img src="@book.ImageURL" class="book-image" alt="@book.Title" />

                    @if (book.OnSale && book.OffPercentage > 0)
                    {
                        <div class="sale-badge">@book.OffPercentage% OFF</div>
                    }
                </div>

                <div class="book-info">
                    <div class="book-text-content">
                        <h4 class="book-title">@book.Title</h4>

                        <p class="author-name">
                            @for (int i = 0; i < book.Authors.Count; i++)
                            {
                                var author = book.Authors[i];
                                <a href="/author/@author.Id" class="author-link">@author.Name</a>

                                @if (i < book.Authors.Count - 1)
                                {
                                    <span>, </span>
                                }
                            }
                        </p>

                        <p class="book-detail">Language: @(book.Language == 0 ? "English" : "Georgian")</p>
                        <p class="book-detail">Available: @book.Quantity</p>
                    </div>

                    @if (book.AlreadyInCart)
                    {
                        <button class="add-to-cart-btn secondary" disabled>In Cart</button>
                    }
                    else
                    {
                        <button class="add-to-cart-btn" @onclick="() => AddToCart(book)">Add to Cart</button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="pagination-footer">
        <button class="page-btn" disabled="@(currentPage == 1)" @onclick="PreviousPage">Previous</button>
        <span>Page @currentPage</span>
        <button class="page-btn" @onclick="NextPage">Next</button>
    </div>
}

@code {
    private List<Book>? books;
    private string searchQuery = "";
    private int currentPage = 1;
    private const int pageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            books = null;
            var url = $"books/page?pageNumber={currentPage}&pageSize={pageSize}";
            var response = await Http.GetFromJsonAsync<PagedResponse>(url);

            if (response != null)
            {
                books = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message}");
        }
    }

    private async Task AddToCart(Book book)
    {
        try
        {
            book.AlreadyInCart = true;
            Console.WriteLine($"Added {book.Title} to cart.");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error adding to cart: {ex.Message}");
        }
    }

    private async Task NextPage()
    {
        currentPage++;
        await LoadData();
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadData();
        }
    }

    private IEnumerable<Book> FilteredBooks =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? books ?? new()
            : (books ?? new()).Where(b => b.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));
}
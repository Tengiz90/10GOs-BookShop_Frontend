@page "/books"
@using TGBooksFrontend.Models
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject TGBooksFrontend.Services.CartService CartService

<PageTitle>@(string.IsNullOrEmpty(_categoryName) ? "Category" : _categoryName) Books</PageTitle>

<div class="category-page-container">
    <div class="category-books-header">
        <button class="back-btn" @onclick="GoBack">
            <span class="arrow">←</span> Go Back
        </button>
        @if (!string.IsNullOrEmpty(_categoryName))
        {
            <h3>Books in <span class="highlight-category">@_categoryName</span> category</h3>
        }
        else
        {
            <h3>Books in the Category</h3>
        }
    </div>
    <hr />

    @if (books == null)
    {
        <div class="loading-container main-fill-space">
            <div class="spinner"></div>
            <p>Loading books for this category...</p>
        </div>
    }
    else if (!books.Any())
    {
        <div class="loading-container main-fill-space">
            <p>No books available in this category right now.</p>
        </div>
    }
    else
    {
        <div class="book-grid">
            @foreach (var book in books)
            {
                <div class="book-card" @key="book.Id" @onclick="() => NavigateToBookDetails(book.Id)">
                    <div class="image-container">
                        <img src="@book.ImageURL" class="book-image" alt="@book.Title" />

                        @if (book.OnSale && book.OffPercentage > 0)
                        {
                            <div class="sale-badge">@book.OffPercentage% OFF</div>
                        }
                    </div>

                    <div class="book-info">
                        <div class="book-text-content">
                            <h4 class="book-title">@book.Title</h4>

                            <p class="author-name">
                                @if (book.Authors != null)
                                {
                                    @for (int i = 0; i < book.Authors.Count; i++)
                                    {
                                        var author = book.Authors.ElementAt(i);
                                        <a href="/author/@author.Id" class="author-link">@author.Name</a>

                                        @if (i < book.Authors.Count - 1)
                                        {
                                            <span>, </span>
                                        }
                                    }
                                }
                            </p>

                            <p class="book-detail">Language: @GetLanguageDisplay(book.Language)</p>
                            <p class="book-detail">Available: @book.Quantity</p>

                            <div class="price-container">
                                @if (book.OnSale && book.OffPercentage > 0)
                                {
                                    <span class="final-price">₾@CalculateDiscountedPrice(book.OriginalPrice, book.OffPercentage).ToString("0.00")</span>
                                    <span class="original-price crossed">₾@book.OriginalPrice.ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="final-price">₾@book.OriginalPrice.ToString("0.00")</span>
                                }
                            </div>
                        </div>

                        @if (book.AlreadyInCart)
                        {
                            <button class="add-to-cart-btn secondary" @onclick:stopPropagation="true" disabled>In Cart</button>
                        }
                        else
                        {
                            <button class="add-to-cart-btn"
                                    @onclick="() => AddToCart(book)"
                                    @onclick:stopPropagation="true">
                                Add to Cart
                            </button>
                        }
                    </div>
                </div>
            }
        </div>

        @* Reused Pagination Footer Controls *@
        <div class="pagination-footer">
            <button class="page-btn" disabled="@(currentPage == 1)" @onclick="PreviousPage">Previous</button>
            <span>Page @currentPage</span>
            <button class="page-btn" disabled="@(!hasNextPage)" @onclick="NextPage">Next</button>
        </div>
    }
</div>

@code {
    private List<Book>? books;
    private int currentPage = 1;
    private const int pageSize = 20;
    private bool hasNextPage = false;
    private string? _categoryName;

    // Captures ?categoryId=X from the routing path automatically
    [Parameter]
    [SupplyParameterFromQuery]
    public int CategoryId { get; set; }

    // Listens for external routing value mutations
    protected override async Task OnParametersSetAsync()
    {
        // Reset page number back to 1 if the user switches categories directly
        currentPage = 1;
        _categoryName = null; // Clear old name layout on transitions
        // Load data and fetch the verified category name simultaneously
        await Task.WhenAll(LoadData(), FetchCategoryName());
    }

    private async Task FetchCategoryName()
    {
        if (CategoryId <= 0) return;

        try
        {
            // Calls your newly added backend controller endpoint securely
            var url = $"categories/get-name/{CategoryId}";
            var response = await Http.GetFromJsonAsync<ApiResponse<string>>(url);

            if (response != null && response.WasSuccessful)
            {
                _categoryName = response.Data;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching category name: {ex.Message}");
            _categoryName = "Category"; // Fallback text safely
        }
    }

    private decimal CalculateDiscountedPrice(decimal originalPrice, int offPercentage)
    {
        decimal discountMultiplier = 100 - offPercentage;
        return (originalPrice * discountMultiplier) / 100;
    }

    private async Task LoadData()
    {
        try
        {
            // Matches backend route signature: [HttpGet("page")]
            var url = $"books/page?categoryId={CategoryId}&pageNumber={currentPage}&pageSize={pageSize}";

            var response = await Http.GetFromJsonAsync<ApiResponse<List<Book>>>(url);

            if (response != null && response.WasSuccessful && response.Data != null)
            {
                books = response.Data;
                hasNextPage = books.Count == pageSize;
            }
            else
            {
                books = new List<Book>();
                hasNextPage = false;
                Console.WriteLine($"API Warning: {response?.Message ?? "Unknown error"}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching category books: {ex.Message}");
            books = new List<Book>();
            hasNextPage = false;
        }
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }

    private string GetLanguageDisplay(int languageValue)
    {
        return languageValue switch
        {
            0 => "English",
            1 => "Georgian",
            2 => "Russian",
            3 => "German",
            4 => "French",
            5 => "Spanish",
            6 => "Polish",
            _ => "Unknown"
        };
    }

    private async Task AddToCart(Book book)
    {
        await CartService.AddToCartAsync(book);
        book.AlreadyInCart = true; // Instantly lock look layout locally on action click
    }

    private async Task NextPage()
    {
        if (hasNextPage)
        {
            currentPage++;
            books = null; // Instantly show spinner
            await LoadData();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            books = null; // Instantly show spinner
            await LoadData();
        }
    }

    private void NavigateToBookDetails(int bookId)
    {
        Navigation.NavigateTo($"book/{bookId}");
    }
}